# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=

# Stripe (dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# URL pública de la app (sin barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto para proteger la ruta de cron (genera uno aleatorio, ej: openssl rand -hex 32)
CRON_SECRET=

# Resend (resend.com/api-keys) — envío del informe mensual por email
RESEND_API_KEY=
