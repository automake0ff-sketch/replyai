# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=

# Stripe (dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# URL pública de la app (sin barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto para proteger la ruta de cron (genera uno aleatorio, ej: openssl rand -hex 32)
CRON_SECRET=

# Resend (resend.com/api-keys) — envío del informe mensual por email
RESEND_API_KEY=

# Emails con acceso a /admin/metrics, separados por coma (ej: tu@email.com)
ADMIN_EMAILS=

# Google Business Profile (respuesta directa a reseñas sin copiar/pegar).
# Requiere solicitar acceso a la API de Business Profile en Google Cloud
# (revisión manual de Google) y crear credenciales OAuth con el scope
# business.manage. Mientras no estén, la tarjeta en Ajustes muestra
# "Próximamente" y no hace falta rellenar esto.
GOOGLE_GBP_CLIENT_ID=
GOOGLE_GBP_CLIENT_SECRET=

# URL pública de la app, para construir el redirect_uri de OAuth de GBP.
# Si no se define, se usa https://replyai-seven.vercel.app como default.
NEXT_PUBLIC_APP_URL=
